rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 방문자 수: visits/total, visits/YYYY-MM-DD
    // 누구나 읽을 수 있고, 쓰기는 count 필드를 1씩 올리는 것만 허용
    match /visits/{dayId} {
      allow read: if true;

      allow create: if isVisitDoc(dayId)
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;

      allow update: if isVisitDoc(dayId)
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    function isVisitDoc(id) {
      return id == 'total' || id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 방명록: guestbook/{자동 id}
    // 누구나 읽고 쓸 수 있지만, 정해진 필드와 길이만 허용. 수정·삭제는 막아 둔다.
    match /guestbook/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'minimi', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'minimi', 'createdAt'])
        && isText(request.resource.data.name, 10)
        && isText(request.resource.data.message, 200)
        && request.resource.data.createdAt == request.time
        && isMinimi(request.resource.data.minimi);

      allow update, delete: if false;
    }

    function isText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // 범위는 src/cyworld/minimiParts.ts 의 배열 길이와 맞춰야 한다
    function isMinimi(m) {
      return m is map
        && m.keys().hasOnly(['skin', 'hair', 'hairColor', 'outfit', 'outfitColor'])
        && m.keys().hasAll(['skin', 'hair', 'hairColor', 'outfit', 'outfitColor'])
        && isIndex(m.skin, 20)
        && isIndex(m.hair, 17)
        && isIndex(m.hairColor, 20)
        && isIndex(m.outfit, 17)
        && isIndex(m.outfitColor, 20);
    }

    function isIndex(value, size) {
      return value is int && value >= 0 && value < size;
    }

    // 그 외 모든 문서는 접근 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
